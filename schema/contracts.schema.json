{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Greatbeing/cognitive-engine/schema/contracts.schema.json",
  "title": "Cognitive Engine contracts v0.1",
  "description": "TaskSpec, RoutingDecision, ExecutionTrace, EvaluationReport. Mirrors what the v0.1 code actually emits; validated in tests.",
  "$defs": {
    "TaskSpec": {
      "type": "object",
      "required": ["id", "objective"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "objective": {"type": "string", "minLength": 1},
        "inputs": {"type": "object"},
        "constraints": {"type": "object"},
        "risk_class": {"enum": ["low", "medium", "high", null]},
        "success_criteria": {"type": "array", "items": {"type": "string"}},
        "budget": {"type": "object"},
        "domain": {"type": "string"},
        "split": {"enum": ["dev", "test"]},
        "assertions": {"type": "array", "items": {"type": "object", "required": ["type"]}}
      }
    },
    "RoutingDecision": {
      "type": "object",
      "required": ["schema_version", "id", "task_id", "policy_version", "status", "features", "plan", "rejected", "rationale", "fallback"],
      "properties": {
        "schema_version": {"const": "0.1"},
        "id": {"type": "string"},
        "task_id": {"type": "string"},
        "policy_version": {"type": "string"},
        "status": {"enum": ["selected", "abstain", "escalate"]},
        "features": {"type": "object", "required": ["task_class", "confidence", "risk"]},
        "plan": {"type": "array", "items": {"type": "object", "required": ["step", "primitive", "family"]}},
        "rejected": {"type": "array"},
        "rationale": {"type": "array", "items": {"type": "string"}},
        "fallback": {"type": "string"}
      }
    },
    "ExecutionTrace": {
      "type": "object",
      "required": ["schema_version", "type", "task_id", "condition", "model", "prompt_sha", "latency_s", "usage", "error", "output"],
      "properties": {
        "schema_version": {"const": "0.1"},
        "type": {"const": "ExecutionTrace"},
        "task_id": {"type": "string"},
        "condition": {"enum": ["baseline", "strong", "single", "composition", "engine"]},
        "model": {"type": "string"},
        "plan": {"type": ["array", "null"]},
        "prompt_sha": {"type": "string"},
        "latency_s": {"type": "number", "minimum": 0},
        "usage": {"type": "object"},
        "error": {"type": ["string", "null"]},
        "output": {"type": "string"}
      }
    },
    "EvaluationReport": {
      "type": "object",
      "required": ["conditions", "lift", "reference"],
      "properties": {
        "conditions": {"type": "object"},
        "lift": {"type": "object"},
        "reference": {"type": "string"},
        "split": {"type": ["string", "null"]}
      }
    }
  }
}
