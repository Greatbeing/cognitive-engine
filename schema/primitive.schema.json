{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Greatbeing/cognitive-engine/schema/primitive.schema.json",
  "title": "Cognitive Primitive",
  "description": "Schema v0.1. Required = what writing-engines atoms can already supply; spec fields not yet backed by evidence are optional and tracked by `completeness`.",
  "type": "object",
  "required": ["schema_version", "id", "name", "version", "purpose", "family", "procedure", "lifecycle", "provenance"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "id": {"type": "string", "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "purpose": {"type": "string", "minLength": 4},
    "family": {"type": "string"},
    "kind": {"enum": ["domain", "general"], "description": "domain = distilled from a writing engine; general = newly authored reasoning op. Never pool them in transfer claims."},
    "domain": {"type": "string"},
    "tags": {"type": "array", "items": {"type": "string"}},
    "trigger_conditions": {"type": "array", "items": {"type": "string"}},
    "preconditions": {"type": "array", "items": {"type": "string"}},
    "inputs": {"type": "object", "additionalProperties": {"type": "string"}},
    "procedure": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "outputs": {"type": "object", "additionalProperties": {"type": "string"}},
    "postconditions": {"type": "array", "items": {"type": "string"}},
    "evaluation": {"type": "object", "properties": {"criteria": {"type": "array", "items": {"type": "string"}}, "method": {"type": "string"}}},
    "failure_modes": {"type": "array", "items": {"type": "string"}},
    "examples": {"type": "array", "items": {"type": "string"}},
    "resource_profile": {"type": "object"},
    "safety_constraints": {"type": "array", "items": {"type": "string"}},
    "transfer": {"type": "array", "items": {"type": "string"}, "description": "Hypothesised target domains. A hypothesis until an EXP shows transfer_gain."},
    "lifecycle": {"enum": ["proposed", "draft", "tested", "validated", "stable", "deprecated"]},
    "provenance": {"type": "object", "required": ["source"], "properties": {"source": {"type": "string"}, "source_ref": {"type": "string"}, "evidence": {"type": "string"}, "author": {"type": "string"}}},
    "completeness": {"type": "number", "minimum": 0, "maximum": 1}
  },
  "additionalProperties": true
}
